# Modèle des variables d'environnement de Plumbly.
# Copier ce fichier en .env (non versionné) puis remplacer chaque "a-changer" :
#   PowerShell : Copy-Item .env.example .env
#   Bash       : cp .env.example .env
# Les mots de passe sont insérés dans des URL de connexion : utiliser uniquement
# des lettres, des chiffres, des tirets et des underscores.

# Fuseau horaire de l'entreprise (La Réunion, UTC+4, sans heure d'été).
# Les dates restent stockées en UTC ; ce fuseau sert à l'affichage et aux logs.
TZ=Indian/Reunion

# ---------- PostgreSQL (données métier) ----------
POSTGRES_USER=plumbly
POSTGRES_PASSWORD=a-changer
POSTGRES_DB=plumbly
# Port exposé sur le poste. Mettre 5433 si un PostgreSQL est déjà installé sur 5432.
POSTGRES_PORT=5432

# ---------- MongoDB (journal des actions) ----------
MONGO_USER=plumbly
MONGO_PASSWORD=a-changer
MONGO_DB=plumbly
# Mettre 27018 si un MongoDB est déjà installé sur 27017.
MONGO_PORT=27017

# ---------- Applications ----------
API_PORT=3000
FRONT_PORT=5173

# ---------- Lancement de l'API hors Docker ----------
# docker-compose.yml construit lui-même ces URL pour les conteneurs.
# Pour lancer l'API sur le poste (npm run start:dev dans backend/),
# copier ces deux lignes dans backend/.env avec les mêmes valeurs que ci-dessus :
# DATABASE_URL=postgresql://plumbly:a-changer@localhost:5432/plumbly?schema=public
# MONGODB_URI=mongodb://plumbly:a-changer@localhost:27017/plumbly?authSource=admin
